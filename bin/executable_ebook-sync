#!/usr/bin/env zsh
# ebook-sync: stop calibre-web on the NAS, rsync the local library to it,
# restart it, then open the web UI.
#
# DOTPRIVATE_*: ~/.config/shell/env.private (sourced by ~/.config/shell/init.sh;
# generated by chezmoi from 1Password DEV/dotfiles-private)

: ${DOTPRIVATE_NAS_HOST:?not set; see ~/.config/shell/env.private}
: ${DOTPRIVATE_NAS_DOCKER:?not set; see ~/.config/shell/env.private}
: ${DOTPRIVATE_NAS_BOOKS_DIR:?not set; see ~/.config/shell/env.private}
: ${DOTPRIVATE_BOOKS_URL:?not set; see ~/.config/shell/env.private}

CONTAINER="calibre-web"
LOCAL_LIBRARY="$HOME/arkon/mda/books/library"

echo "Shutting down docker container..."
ssh "$DOTPRIVATE_NAS_HOST" "$DOTPRIVATE_NAS_DOCKER stop $CONTAINER"
echo -e "Shutdown complete. Syncing...\n"
sleep 1
rsync --recursive --times --verbose --verbose --delete --human-readable --copy-links "$LOCAL_LIBRARY"/* "$DOTPRIVATE_NAS_HOST:$DOTPRIVATE_NAS_BOOKS_DIR"
echo -e "\nSync complete\n"
sleep 1
echo "Starting up docker container..."
ssh "$DOTPRIVATE_NAS_HOST" "$DOTPRIVATE_NAS_DOCKER start $CONTAINER"
echo "Startup complete"
sleep 45
open "$DOTPRIVATE_BOOKS_URL"
