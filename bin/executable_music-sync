#!/usr/bin/env zsh
# DOTPRIVATE_*: ~/.config/shell/env.private (sourced by ~/.config/shell/init.sh;
# generated by chezmoi from 1Password DEV/dotfiles-private)

# whether to prompt for the conversion and sync step
CONVERT=true

# whether to prompt for sync to NAS server
SERVER=true

# beta refers to the library release:
# * full release is in Beehive Library
# * beta release is in the export/mp3-6 local directory
ESBETA=true

# ==============================================================
# ABOUT
# ==============================================================
# this script looks at multiple music and playlist sources and
# identifies which of multiple known digital audio players (DAPs)
# are connected (or which of their SD cards are mounted). it then
# makes sure the music library of files is updated on the DAP.
# if any swinsian playlists have been exported to a known location
# this script will take those and process them to work on the DAP
# that is mounted (at minimum rewriting the file paths, in some
# cases also changing the file encoding so that the DAP can read
# unicode characters correctly in artists like Björk and Sigur Rós)

# print cool script title
# (make more with `figlet -f cybermedium "MUSIC-SYNC"`)

cat << EOF
_  _ _  _ ____ _ ____    ____ _   _ _  _ ____
|\/| |  | [__  | |    __ [__   \_/  |\ | |
|  | |__| ___] | |___    ___]   |   | \| |___

----------------------------------------------------------------

EOF

# ==============================================================
# DAP SPECIFIC VALUES
# ==============================================================
# these would be better in a config file but then we're getting
# complicated. also better as an array but with just a couple of
# players in use it's not critical.

Q2_VOLUME=/Volumes/SHANLING-Q2
Q2_NAME="Shanling Q2"
Q2_TARGET_MUSIC_DIR="Music"
Q2_TARGET_PODCASTS_DIR=""
X3_TARGET_AUDIOBOOKS_DIR=""
Q2_TARGET_PLAYLISTS_DIR="_explaylist_data"

X3_VOLUME=/Volumes/XDUOO-X3II
X3_NAME="Xduoo X3ii"
X3_TARGET_MUSIC_DIR="Music"
X3_TARGET_PODCASTS_DIR="Podcasts"
X3_TARGET_AUDIOBOOKS_DIR="Audiobooks"
X3_TARGET_PLAYLISTS_DIR="Playlists"

EROSQ_VOLUME=/Volumes/EROSQ
EROSQ_NAME="Eros Q"
EROSQ_TARGET_MUSIC_DIR="Music"
EROSQ_TARGET_PODCASTS_DIR="Podcasts"
EROSQ_TARGET_AUDIOBOOKS_DIR="Audiobooks"
EROSQ_TARGET_PLAYLISTS_DIR="Playlists"

# ==============================================================
# STRINGS
# ==============================================================
# see note above... config or array better but it works now so...

SOURCE_MUSIC_NAME="Beehive Music Library"
SOURCE_PLAYLISTS_EXPORT_NAME="Exported Playlists"
SOURCE_PODCASTS_NAME="Podcast Folder"
SOURCE_PLAYLISTS_ARCHIVE_NAME="Playlist Archive folder"

# ==============================================================
# SET PATHS BASED ON USER
# ==============================================================
# it's just me and my daughter using this right now

DAP_VOLUME=""
if [[ $USER == "es" ]]; then
	if [[ $ESBETA == "true" ]]; then
		SOURCE_MUSIC_PATH="$HOME/arkon/mda/audio/export/mp3-6"
	else
		SOURCE_MUSIC_PATH="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Beehive Music Library"
	fi
	SOURCE_PODCASTS_PATH="$HOME/arkon/mda/audio/podcasts"
	SOURCE_PLAYLISTS_EXPORT_PATH="$HOME/arkon/mda/audio/playlists/exports"
	TARGET_PLAYLISTS_ARCHIVE_PATH="$HOME/arkon/mda/audio/playlists/archive"
else
	SOURCE_MUSIC_PATH="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Beehive Music Library"
	SOURCE_PLAYLISTS_EXPORT_PATH="$HOME/Playlist-Export"
	SOURCE_PODCASTS_PATH="$HOME/arkon/mda/audio/data/swinsian/Podcasts"
	TARGET_PLAYLISTS_ARCHIVE_PATH="$HOME/Playlist-Archive"
fi

# ==============================================================
# IDENTIFY CURRENT PLAYER
# ==============================================================
# depending on the player and size of the SD card we could use
# different formats (e.g. the flac originals or the mp3 conversions)

DAP_ROCKBOX=false

if [[ -d $Q2_VOLUME ]]; then
    DAP_VOLUME=$Q2_VOLUME
    DAP_NAME="$Q2_NAME"
    DAP_TARGET_MUSIC_DIR=$Q2_TARGET_MUSIC_DIR
    DAP_TARGET_PODCASTS_DIR=$Q2_TARGET_PODCASTS_DIR
    DAP_TARGET_AUDIOBOOKS_DIR=$Q2_TARGET_AUDIOBOOKS_DIR
    DAP_TARGET_PLAYLISTS_DIR=$Q2_TARGET_PLAYLISTS_DIR
    DAP_FILE_SUFFIX=mp3
elif [[ -d $X3_VOLUME ]]; then
    DAP_VOLUME=$X3_VOLUME
    DAP_NAME="$X3_NAME"
    DAP_TARGET_MUSIC_DIR=$X3_TARGET_MUSIC_DIR
    DAP_TARGET_PODCASTS_DIR=$X3_TARGET_PODCASTS_DIR
    DAP_TARGET_AUDIOBOOKS_DIR=$X3_TARGET_AUDIOBOOKS_DIR
    DAP_TARGET_PLAYLISTS_DIR=$X3_TARGET_PLAYLISTS_DIR
    DAP_FILE_SUFFIX=mp3
    DAP_ROCKBOX=true
elif [[ -d $EROSQ_VOLUME ]]; then
    DAP_VOLUME=$EROSQ_VOLUME
    DAP_NAME="$EROSQ_NAME"
    DAP_TARGET_MUSIC_DIR=$EROSQ_TARGET_MUSIC_DIR
    DAP_TARGET_PODCASTS_DIR=$EROSQ_TARGET_PODCASTS_DIR
    DAP_TARGET_AUDIOBOOKS_DIR=$EROSQ_TARGET_AUDIOBOOKS_DIR
    DAP_TARGET_PLAYLISTS_DIR=$EROSQ_TARGET_PLAYLISTS_DIR
    DAP_FILE_SUFFIX=mp3
    DAP_ROCKBOX=true
fi

# ==============================================================
# DEFINE FUNCTIONS
# ==============================================================
# sync_source_to_target is common but the process-playlist func
# is specific to each player (the Q2 is very fussy)

sync_source_to_target () {
	# $1 == target volume name
	# $2 == readable name
	# $3 == source folder
	# $4 == source name
	# $5 == target directory
	echo -e "\n===> SYNCING $4 to $2... (ctrl-c to abort sync)"
	# dry run the rsync with: --list-only --verbose
	# bookmark.*ignore (includes bookmark.ignore and bookmark.unignore) are
	# control files for bookmarking in rockbox
	rsync --progress --recursive --ignore-existing --times --delete --iconv=utf-8,utf-8-mac --exclude='.[!.]*' --exclude='bookmark.*ignore' --human-readable "$3/" "$1/$5/"
	echo -e "===> Sync from $4 to $2 ...COMPLETE!\n"
}

if [[ -d $Q2_VOLUME ]]; then
	process-playlist () {
		# Change path (unneeded for shanling q2 conversion)
		# sed -i '' 's/^.*Beehive\ Music\ Library/\/Music/g' $1

		# Remove path prefix
		sed -i '' 's/^.*Beehive\ Music\ Library/Music/g' $1
		sed -i '' 's/^.*mda\/audio\/music/Music/g' $1
		sed -i '' 's/^\.\.\/\.\.\/music/Music/g' $1

		# change suffix (unneeded for Sage's setup with beehive mp3 format)
		if [[ $DAP_FILE_SUFFIX == "mp3" ]]; then
		    sed -i '' 's/\.flac$/\.mp3/g' $1
		fi

		# remove all commented and blank lines
		#grep -Ev '^\s*$|^\s*\#' $1
		sed -i '' 's/#.*$//' $1
		sed -i '' '/^$/d' $1

		# change slash to backslash
		sed -i '' 's/\//\\/g' $1

		# append drive prefix to all lines
		sed -i '' 's/^/A:\\/g' $1

        # convert file encoding for q2, which doesn't like mac utf8
		TMPDIR=$(mktemp -d)
		mv "$1" "$TMPDIR/${1:t}"
		iconv -f UTF-8-MAC -t UTF-8 "$TMPDIR/${1:t}" > "$1"
		rm -f "$TMPDIR/${1:t}"
		rm -rf $TMPDIR
	}
elif $DAP_ROCKBOX; then
	process-playlist () {
		# Remove path prefix
		sed -i '' 's/^.*mda\/audio\/music/\/Music/g' $1
		sed -i '' 's/^\.\.\/\.\.\/music/\/Music/g' $1

		if [[ $DAP_FILE_SUFFIX == "mp3" ]]; then
		    sed -i '' 's/\.flac$/\.mp3/g' $1
		fi
        # convert file encoding for q2, which doesn't like mac utf8
        TMPDIR=$(mktemp -d)
        mv "$1" "$TMPDIR/${1:t}"
        iconv -f UTF-8-MAC -t UTF-8 "$TMPDIR/${1:t}" > "$1"
        rm -f "$TMPDIR/${1:t}"
        rm -rf $TMPDIR
	}
fi

# ==============================================================
# MAKE POTENTIALLY MISSING FOLDERS
# ==============================================================
# rsync might handle this depending on flags but may as well just
# make sure that it's done explicitly here

mkdir -p $TARGET_PLAYLISTS_ARCHIVE_PATH
mkdir -p $SOURCE_PLAYLISTS_EXPORT_PATH
if [[ -n $DAP_VOLUME ]]; then
    [[ -n $DAP_TARGET_MUSIC_DIR ]] && mkdir -p $DAP_VOLUME/$DAP_TARGET_MUSIC_DIR
    [[ -n $DAP_TARGET_PODCASTS_DIR ]] && mkdir -p $DAP_VOLUME/$DAP_TARGET_PODCASTS_DIR
    [[ -n $DAP_TARGET_AUDIOBOOKS_DIR ]] && mkdir -p $DAP_VOLUME/$DAP_TARGET_AUDIOBOOKS_DIR
    [[ -n $DAP_TARGET_PLAYLISTS_DIR ]] && mkdir -p $DAP_VOLUME/$DAP_TARGET_PLAYLISTS_DIR
fi
if $DAP_ROCKBOX; then
    [[ -n $DAP_TARGET_MUSIC_DIR ]] && touch $DAP_VOLUME/$DAP_TARGET_MUSIC_DIR/bookmark.ignore
    [[ -n $DAP_TARGET_PODCASTS_DIR ]] && touch $DAP_VOLUME/$DAP_TARGET_PODCASTS_DIR/bookmark.unignore
    [[ -n $DAP_TARGET_AUDIOBOOKS_DIR ]] && touch $DAP_VOLUME/$DAP_TARGET_AUDIOBOOKS_DIR/bookmark.unignore
fi

# ==============================================================
# RUN A CONVERT COMMAND TO UPDATE MP3S FROM FLAC SOURCES
# ==============================================================
# only for me since I manaage the flac library and mp3 conversions

if [[ $USER == "es" && $CONVERT == "true" ]]; then
cat << EOF
____ ____ _  _ _  _ ____ ____ ___ _ _  _ ____
|    |  | |\ | |  | |___ |__/  |  | |\ | | __
|___ |__| | \|  \/  |___ |  \  |  | | \| |__]

EOF
    if read -q "choice?Press Y/y to iniate a convert and sync to Beehive Library mp3s: "; then
	echo -e "\nInitiating convert"
    	beet convert -a;
    else
	echo -e "\nSkipping convert"
    fi
fi

if [[ $USER == "es" && $CONVERT == "true" ]]; then
cat << EOF
____ _   _ _  _ ____     ___ ____    _ ____ _    ____ _  _ ___ 
[__   \_/  |\ | |    .    |  |  |    | |    |    |  | |  | |  \ 
___]   |   | \| |___ .    |  |__|    | |___ |___ |__| |__| |__/ 

EOF
    if read -q "choice?Press Y/y to iniate a sync exported MP3s to the iCloud Beehive Library: "; then
	echo -e "\nInitiating sync to iCLoud"
    	# --dry-run --itemize-changes 
    	rsync --recursive --times --verbose --verbose --delete --human-readable --copy-links "$HOME/arkon/mda/audio/export/mp3-6/" "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Beehive Music Library/"
    else
	echo -e "\nSkipping sync to iCloud"
    fi
fi

if [[ $USER == "es" && $SERVER == "true" ]]; then
cat << EOF
____ _   _ _  _ ____     ___ ____    ____ ____ ____ _  _ ____ ____
[__   \_/  |\ | |    .    |  |  |    [__  |___ |__/ |  | |___ |__/
___]   |   | \| |___ .    |  |__|    ___] |___ |  \  \/  |___ |  \

EOF
    if read -q "choice?Press Y/y to iniate a sync of MP3 exports to local NAS: "; then
    	# --dry-run --itemize-changes 
	: ${DOTPRIVATE_NAS_HOST:?not set; see ~/.config/shell/env.private}
	rsync --recursive --times --verbose --verbose --delete --human-readable --copy-links "$HOME/arkon/mda/audio/music/" "$DOTPRIVATE_NAS_HOST:$DOTPRIVATE_NAS_MUSIC_DIR/"
	echo "Syncing to NAS"
    else
    fi
fi

# ==============================================================
# SYNC MUSIC LIBRARY TO CARD
# ==============================================================
# skip if no DAP mounted


if [[ -n $DAP_VOLUME ]]; then
cat << EOF
____ _   _ _  _ ____     ___ ____ ____ ____ _  _ ____
[__   \_/  |\ | |    .    |  |__/ |__| |    |_/  [__
___]   |   | \| |___ .    |  |  \ |  | |___ | \_ ___]

EOF
sync_source_to_target "$DAP_VOLUME" "$DAP_NAME" "$SOURCE_MUSIC_PATH" "$SOURCE_MUSIC_NAME" "$DAP_TARGET_MUSIC_DIR"

if [[ $USER == "es" && -n $DAP_TARGET_PODCASTS_DIR ]]; then
cat << EOF
____ _   _ _  _ ____     ___  ____ ___  ____ ____ ____ ___ ____
[__   \_/  |\ | |    .   |__] |  | |  \ |    |__| [__   |  [__
___]   |   | \| |___ .   |    |__| |__/ |___ |  | ___]  |  ___]

EOF
sync_source_to_target "$DAP_VOLUME" "$DAP_NAME" "$SOURCE_PODCASTS_PATH" "$SOURCE_PODCASTS_NAME" "$DAP_TARGET_PODCASTS_DIR"
fi

fi

# ==============================================================
# SYNC PLAYLISTS TO CARD
# ==============================================================

# clean out old playlists so they don't get reimported
# first copying (or moving) to localarchive

cat << EOF
____ _   _ _  _ ____     ___  _    ____ _   _ _    _ ____ ___ ____
[__   \_/  |\ | |    .   |__] |    |__|  \_/  |    | [__   |  [__
___]   |   | \| |___ .   |    |___ |  |   |   |___ | ___]  |  ___]

EOF

# This was the code block to remove and archive playlists.
# Removed because unnecessary on the Q2 and unwanted on the X3/Rockbox

# if [[ -n "$DAP_VOLUME/$DAP_TARGET_PLAYLISTS_DIR/*.m3u(#qN)" ]]; then
# 	echo -e "\n===> Removing old exported playlists from DAP..."
# 	ARCHIVE_PLAYLISTS=( $DAP_VOLUME/$DAP_TARGET_PLAYLISTS_DIR/*.m3u(N) )
#     if [ -n "$ARCHIVE_PLAYLISTS" ]; then
#         for ARCHIVE_PLAYLIST in $ARCHIVE_PLAYLISTS; do
#            	echo -e "===> Archiving old playlist ${ARCHIVE_PLAYLIST:t:r} from DAP to $TARGET_PLAYLISTS_ARCHIVE_PATH"
#            	mv "$ARCHIVE_PLAYLIST" "$TARGET_PLAYLISTS_ARCHIVE_PATH/$(date +%F) $DAP_NAME ${ARCHIVE_PLAYLIST:t}"
#         done
#     fi
# fi

# rename file from m3u8 (the Swinsian default export suffix) to m3u
# the shanling will import m3u8 files but it creates a second "dotfile"
# playlist for some reason, so changing the suffix fixes this
# :t:r takes the rootname (no extension) of the tail (no path prefix)

if [[ -n $DAP_TARGET_PLAYLISTS_DIR ]]; then
    PLAYLISTS=( $SOURCE_PLAYLISTS_EXPORT_PATH/*.m3u8(N) )
    if [ ! -n "$PLAYLISTS" ]; then
    	echo -e "===> No playlists found. Export lists from Swinsian to '$SOURCE_PLAYLISTS_EXPORT_PATH' folder.\n"
    else
        for PLAYLIST in $PLAYLISTS; do
           	echo -e "===> Processing ${PLAYLIST:t:r}"
           	process-playlist "$PLAYLIST"
           	mv $PLAYLIST $DAP_VOLUME/$DAP_TARGET_PLAYLISTS_DIR/${PLAYLIST:t:r}.m3u
        done
    fi
else
    echo "No known DAP / SD card found. Mount DAP or card to sync."
fi

echo ""

cat << EOF
___  ____ _  _ ____   /
|  \ |  | |\ | |___  /
|__/ |__| | \| |___ .

EOF
