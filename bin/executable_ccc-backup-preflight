#!/bin/zsh

# Exit immediately if on battery

if {pmset -g batt | grep -q discharging}; then exit; fi

# ----------------------------------------------
# standard delay in seconds
# ----------------------------------------------

DELAY_SEC=30

# IoT switched outlet control
# DOTPRIVATE_*: ~/.config/shell/env.private (generated by chezmoi from 1Password
# DEV/dotfiles-private). CCC runs this as root, so source it relative to this script.
ENV_PRIVATE="${0:A:h}/../.config/shell/env.private"   # :A follows symlinks
[[ -r $ENV_PRIVATE ]] && source "$ENV_PRIVATE"
: ${DOTPRIVATE_IOT_TIMEMACHINE_URL:?not set; see ~/.config/shell/env.private}
COMMAND="/usr/bin/curl \"${DOTPRIVATE_IOT_TIMEMACHINE_URL}?event="
ON="click\""
OFF="double-click\""

# ----------------------------------------------
# power on drive caddy
# ----------------------------------------------

eval $COMMAND$ON &>/dev/null
sleep $DELAY_SEC

