###############################################################################
# Finder                                                                      #
###############################################################################
# Restart with `killall Finder`.

# Show hidden (dot) files. Toggle in Finder with Cmd+Shift+. Default: false.
defaults write com.apple.finder AppleShowAllFiles -bool true

# Show all filename extensions. Default: false.
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Warn before changing a file extension. Default: true.
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Show the path bar. Default: false.
defaults write com.apple.finder ShowPathbar -bool true

# Show the status bar. Default: false.
defaults write com.apple.finder ShowStatusBar -bool true

# Show the sidebar / tab bar. Default: true / false.
defaults write com.apple.finder ShowSidebar -bool true
defaults write com.apple.finder ShowTabView -bool false

# Show the full POSIX path in the window title. Default: false.
defaults write com.apple.finder _FXShowPosixPathInTitle -bool true

# Show the folder icon in window title bars (setting lives in Accessibility). [FDA] Default: false.
defaults write com.apple.universalaccess showWindowTitlebarIcons -bool true

# Default view: icnv icon | Nlsv list | clmv column | glyv gallery. Default: icnv.
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

# Keep folders on top when sorting by name, in windows / on the desktop. Default: false.
defaults write com.apple.finder _FXSortFoldersFirst -bool true
defaults write com.apple.finder _FXSortFoldersFirstOnDesktop -bool true

# Column view: auto-size columns to fit the longest name. Tahoe+. Default: false.
defaults write com.apple.finder _FXEnableColumnAutoSizing -bool true

# Search the current folder by default: SCcf current | SCsp previous | SCev This Mac. Default: SCev.
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# ??? maybe a subfolder in future
# New windows open at: PfHm home | PfDe Desktop | PfDo Documents | PfLo other path. Default: Recents.
defaults write com.apple.finder NewWindowTarget -string "PfHm"
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/"

# Open folders in tabs instead of new windows. Default: true.
defaults write com.apple.finder FinderSpawnTab -bool true

# Show recent tags in the sidebar. Default: true.
defaults write com.apple.finder ShowRecentTags -bool false

# Remove items from the Trash after 30 days. Default: false.
defaults write com.apple.finder FXRemoveOldTrashItems -bool true

# Warn before emptying the Trash. Default: true.
defaults write com.apple.finder WarnOnEmptyTrash -bool false

# ??? how does this impact raise/run in omniwm scratchpads
# Allow quitting Finder with Cmd+Q (also hides desktop icons). Default: false.
defaults write com.apple.finder QuitMenuItem -bool true

# Disable Finder window and Get Info animations. Default: false.
defaults write com.apple.finder DisableAllAnimations -bool true

# Spring-loaded folders, and the spring-loading delay. Default: true / 0.5.
defaults write NSGlobalDomain com.apple.springing.enabled -bool true
defaults write NSGlobalDomain com.apple.springing.delay -float 0.3

# Expand these Get Info panes: General, Open With, Sharing & Permissions. Default: General only.
defaults write com.apple.finder FXInfoPanesExpanded -dict \
  General -bool true \
  OpenWith -bool true \
  Privileges -bool true

# ??? if this is annoying turn it off
# Open a new Finder window when a volume is mounted. Default: false.
defaults write com.apple.frameworks.diskimages auto-open-ro-root -bool true
defaults write com.apple.frameworks.diskimages auto-open-rw-root -bool true
defaults write com.apple.finder OpenWindowForNewRemovableDisk -bool true

# ??? maybe spawn a finder window first to ensure this doesn't fail
# Icon view: show item info, snap to grid, grid spacing, icon size.
# Fails harmlessly if Finder has never opened a window (keys don't exist yet).
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:showItemInfo true" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:showItemInfo true" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:gridSpacing 64" ~/Library/Preferences/com.apple.finder.plist
/usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:iconSize 64" ~/Library/Preferences/com.apple.finder.plist

