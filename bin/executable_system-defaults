# Lock Dock size and contents. Default: false.
defaults write com.apple.dock size-immutable -bool false
defaults write com.apple.dock contents-immutable -bool false

###############################################################################
# Dock Layout (which icons appear, and in what order)                         #
###############################################################################
# Stored in ~/Library/Preferences/com.apple.dock.plist:
#   persistent-apps    the apps section, left to right (top to bottom if vertical)
#   persistent-others  the right-hand section: folders, stacks, documents
# Finder is always first and Trash always last; neither can be added or removed.
# Default: Apple's stock set (Apps, Safari, Messages, Mail, Maps, Photos, ...)
# plus a Downloads stack.
#
# Method: dockutil (`brew install dockutil`), installed before this script runs.
# The Dock is emptied, then items are added in the order listed, so reorder the
# lines to reorder the Dock. --no-restart on every call; the Dock restarts once
# at the end of the script. If dockutil is missing, this block is skipped.
#
# dockutil quick reference (v3.1.3, github.com/kcrawford/dockutil):
#   --add <path|url> [--label <name>]          add an app, folder, file, or URL
#   --remove <label|bundle id|all|spacer-tiles>
#   --move <label> --position <n|beginning|middle|end>
#   --after <label> | --before <label> | --replacing <label>
#   --section apps|others
#   --type spacer|small-spacer|flex-spacer      (with --add '')
#   --view grid|fan|list|auto   --display folder|stack
#   --sort name|dateadded|datemodified|datecreated|kind
#   --list                                     show the current Dock
# Upstream lists support through Sonoma; Homebrew ships Tahoe builds. There are
# open issues about occasional hangs. [VERIFY] on macOS 27.

if (( $+commands[dockutil] || DRY_RUN )); then
  # Empty the Dock (both sections).
  dockutil --remove all --no-restart

  # Apple apps (paths confirmed on macOS 27).
  dockutil --add "/System/Applications/Apps.app" --no-restart
  dockutil --add "/Applications/Safari.app" --no-restart
  dockutil --add "/System/Applications/Mail.app" --no-restart
  dockutil --add "/Applications/Fantastical.app" --no-restart
  dockutil --add "/System/Applications/Reminders.app" --no-restart
  dockutil --add "/System/Applications/Messages.app" --no-restart
  dockutil --add "/System/Applications/Notes.app" --no-restart
  dockutil --add "/Applications/Ghostty.app" --no-restart
  dockutil --add "/System/Applications/Utilities/Activity Monitor.app" --no-restart
  dockutil --add "/Applications/1Password.app" --no-restart
  dockutil --add "/System/Applications/System Settings.app" --no-restart
  dockutil --add "/System/Applications/Music.app" --no-restart

  # Small gap between groups.
  dockutil --add '' --type small-spacer --section apps --no-restart

  # Third-party developer apps (installed by Homebrew before this script).
  # A missing app is reported as an error and skipped. [VERIFY]
  dockutil --add "/Applications/Visual Studio Code.app" --no-restart
  dockutil --add "/Applications/Google Chrome.app" --no-restart

  # Right-hand section: Downloads, newest first, folder icon, opens as a grid.
  dockutil --add "${HOME}/Downloads" --section others --sort dateadded --display folder --view grid --no-restart

  # Home folder by name, as a list.
  # dockutil --add "${HOME}" --section others --sort name --display folder --view list --no-restart

  # Applications folder as a grid (a classic Launchpad substitute).
  # dockutil --add "/Applications" --section others --sort name --display folder --view grid --no-restart

  # Web URL tile.
  # dockutil --add "https://github.com" --label "GitHub" --section others --no-restart
else
  print "dockutil not found; skipping Dock layout (brew install dockutil)."
fi

# --- Alternative: Dock layout with plain `defaults` (no dockutil) ------------
# Kept for reference. Uncomment this block and comment out the dockutil block
# above to use it. Each list is cleared, then items are added in order. An app
# that isn't installed shows as a "?" icon.

# App tile template: a plain POSIX path between these two strings.
# dock_app='<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>'
# dock_app_end='</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>'

# Clear the apps section.
# defaults write com.apple.dock persistent-apps -array

# Apple apps (paths confirmed on macOS 27).
# defaults write com.apple.dock persistent-apps -array-add "${dock_app}/System/Applications/Apps.app${dock_app_end}"
# defaults write com.apple.dock persistent-apps -array-add "${dock_app}/Applications/Safari.app${dock_app_end}"
# defaults write com.apple.dock persistent-apps -array-add "${dock_app}/System/Applications/Mail.app${dock_app_end}"
