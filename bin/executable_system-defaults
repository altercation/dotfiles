# Xcode & Simulator                                                           #
###############################################################################

# Show build durations in the activity viewer. [VERIFY] Default: false.
defaults write com.apple.dt.Xcode ShowBuildOperationDuration -bool true

# Show indexing progress as a number. [VERIFY] Default: false.
defaults write com.apple.dt.Xcode IDEIndexerActivityShowNumericProgress -bool true

# Trim trailing whitespace, including whitespace-only lines. Default: true / false.
defaults write com.apple.dt.Xcode DVTTextEditorTrimTrailingWhitespace -bool true
defaults write com.apple.dt.Xcode DVTTextEditorTrimWhitespaceOnlyLines -bool true

# Show line numbers. Default: true.
defaults write com.apple.dt.Xcode DVTTextShowLineNumbers -bool true

# Show file extensions in the navigator: 0 default, 1 always, 2 never. [VERIFY] Default: 0.
defaults write com.apple.dt.Xcode IDEFileExtensionDisplayMode -int 1

# Extra counterpart suffixes for Ctrl+Cmd+Up/Down jumping. Default: unset.
# defaults write com.apple.dt.Xcode IDEAdditionalCounterpartSuffixes -array-add "ViewModel" "View"

# Simulator screenshot location. Default: ~/Desktop.
defaults write com.apple.iphonesimulator ScreenShotSaveLocation -string "${HOME}/tmp"

