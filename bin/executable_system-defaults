# --- Firewall ----------------------------------------------------------------
# The com.apple.alf plist was retired in macOS 15; use socketfilterfw.

# ??? double check with little snitch on this
# Turn on the application firewall. Default: off.
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on

# ??? check impact of this
# Stealth mode (don't answer ping/port scans). Default: off.
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on

# Allow signed software to receive connections automatically. Default: on.
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setallowsigned on
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setallowsignedapp on

# --- Finder / volumes --------------------------------------------------------
# Show /Volumes. Default: hidden.
sudo chflags nohidden /Volumes

# --- systemsetup (may need Full Disk Access on recent macOS) ------------------
# Restart automatically if the system freezes. Default: off.
sudo systemsetup -setrestartfreeze on

# Time zone. See `sudo systemsetup -listtimezones`. Default: set during setup.
# sudo systemsetup -settimezone "America/Los_Angeles"

# Kept on: the standard Tailscale macOS app cannot act as a Tailscale SSH server,
# so SSH over the tailnet needs macOS Remote Login.
# Remote Login (SSH). Default: off.
sudo systemsetup -setremotelogin on

# --- Power (pmset) -----------------------------------------------------------
# Check current values with `pmset -g custom`. Stock values vary by model.
# -a = all power sources, -c = charger/AC, -b = battery.

# CHECK THESE SETTINGS ON MINI
# Display sleep on AC, in minutes. Default: 10.
sudo pmset -c displaysleep 15

# System sleep on AC (0 = never; keeps long builds and SSH sessions alive). Default: 1.
sudo pmset -c sleep 0

# Wake for network access on AC. Default: 1.
sudo pmset -c womp 1

# Prevent sleep while an SSH/remote terminal session is active. Default: 1.
sudo pmset -a ttyskeepawake 1

# Power Nap. Default: 1.
sudo pmset -a powernap 0

# Desktops: restart automatically after a power failure. Default: 0.
(( ! IS_LAPTOP )) && sudo pmset -a autorestart 1

# ??? double check my laptop settings and sleepaid app
# Laptop-only power settings (skipped automatically on desktops). [LAPTOP]
if (( IS_LAPTOP )); then
  # Display sleep on battery, in minutes. Default: 2.
  sudo pmset -b displaysleep 5

  # System sleep on battery, in minutes. Default: 1.
  sudo pmset -b sleep 10

  # Wake when the lid opens. Default: 1.
  sudo pmset -a lidwake 1

  # Wake when the charger is connected. Default: 0.
  sudo pmset -a acwake 0

  # Low Power Mode on battery: 0 off, 1 on. Default: 0.
  sudo pmset -b lowpowermode 0

  # Dim the display slightly on battery. Default: 1.
  sudo pmset -b lessbright 1

  # Hibernation: 3 = RAM kept powered and saved to disk (laptop default). Don't
  # delete /var/vm/sleepimage as old scripts do. Default: 3.
  sudo pmset -a hibernatemode 3
fi

# --- Rosetta 2 (non-defaults; for Intel binaries in toolchains) --------------
# Not installed on a fresh macOS 27 and not restored by upgrades. Agrees to the license.
# softwareupdate --install-rosetta --agree-to-license

###############################################################################
# Restart affected apps                                                       #
###############################################################################
# Terminal and iTerm2 are left alone so this script's own window survives.

for app in "Activity Monitor" "Calendar" "cfprefsd" "Contacts" "ControlCenter" \
  "Dock" "Finder" "Mail" "Messages" "Music" "Photos" "Safari" "SystemUIServer" \
  "TextEdit" "WindowManager" "Google Chrome"; do
  killall "$app" 2>/dev/null
done

print "Done. Log out or restart for keyboard, trackpad and some UI changes to apply."
print "Settings marked [FDA] need Full Disk Access for your terminal; re-run after granting it."

###############################################################################
# Reference: obsolete settings from popular scripts (not run)                 #
###############################################################################
# Dashboard (com.apple.dashboard mcx-disabled, devmode, dashboard-in-overlay)
#   - Dashboard was removed in macOS 10.15.
# sudo nvram SystemAudioVolume=" "      - Intel-only; use StartupMute on Apple silicon.
# sudo tmutil disablelocal              - removed in macOS 10.13.
# rm/touch/chflags /private/var/vm/sleepimage - unsafe; breaks safe sleep.
# com.apple.windowserver DisplayResolutionEnabled - Intel/non-Retina HiDPI hack.
# NSGlobalDomain AppleFontSmoothing     - subpixel AA removed in 10.14; only
#                                         toggles grayscale smoothing now.
# com.apple.dock expose-group-by-app    - renamed expose-group-apps (above).
# com.apple.alf globalstate             - plist retired in macOS 15; use socketfilterfw.
# com.apple.menuextra.battery ShowPercent - pre-Big Sur; see controlcenter above.
# com.apple.menuextra.clock DateFormat  - ignored on 26/27; use the Show* keys.
# Safari WebKitJavaEnabled / WebKitPluginsEnabled - Java and NPAPI plug-ins are gone.
# launchctl unload ... notificationcenterui - blocked by SIP.
# lsregister -kill -r ...               - no longer needed; slow.
# com.apple.SoftwareUpdate ScheduleFrequency - not honored on recent macOS.
# com.apple.commerce AutoUpdateRestartRequired - not honored on recent macOS.
