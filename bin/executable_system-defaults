#!/usr/bin/env zsh
###############################################################################
# system-defaults
#
# Clean-slate macOS configuration for a new (or reset) Apple silicon Mac,
# tuned for software development. Universal: safe on laptops and desktops.
# Target: macOS 27 "Golden Gate" (also expected to work on macOS 26 Tahoe).
#
# Usage:
#   system-defaults             apply everything
#   system-defaults --dry-run   print every command instead of running it
#
# Optional dependency: dockutil (`brew install dockutil`) for the Dock Layout
# section. Without it that section is skipped.
#
# Each entry has a one-line description and the stock macOS value
# ("Default:") so the script can also be used to return to a known baseline.
# Some entries deliberately set the stock value.
#
# Tags used in comments:
#   [LAPTOP]  Only matters on a MacBook (battery, lid, built-in trackpad).
#             Harmless on a desktop. Trackpad keys also apply to a Magic Trackpad.
#   [FDA]     Terminal (or iTerm2) needs Full Disk Access to write this domain:
#             System Settings > Privacy & Security > Full Disk Access.
#   [LOGOUT]  Takes effect after logging out or restarting.
#   [VERIFY]  Private, undocumented, or reported broken/unconfirmed on
#             macOS 26/27. Check after running: `defaults read <domain> <key>`
#             and look at the matching System Settings pane.
#
# Tips:
#   - Find a key: `defaults read > before.txt`, change it in System Settings,
#     `defaults read > after.txt`, then `diff before.txt after.txt`.
#   - Revert one setting to stock: `defaults delete <domain> <key>`.
#   - Quit the app you are configuring before writing its domain.
#
# Sources consulted: mathiasbynens/dotfiles .macos, kadirermantr/macos-setup,
# macos-defaults.com (yannbertrand/macos-defaults), ss64.com/mac/syntax-defaults,
# defaults-write.com, emmer.dev, Apple Terminal User Guide, ChristopherA's
# Tahoe gist, OS X Daily (macOS 27), Hacker News discussion of the .macos file.
###############################################################################

###############################################################################
# Preflight                                                                   #
###############################################################################

DRY_RUN=0
case "$1" in
  -n|--dry-run) DRY_RUN=1 ;;
  "") ;;
  *) print "Usage: $0 [--dry-run]"; exit 2 ;;
esac

# Dry run: replace every command that changes the system with a function that
# only prints it. The body of the script stays plain `defaults write ...` lines.
if (( DRY_RUN )); then
  dry() { print -r -- "[dry-run] ${(q-)@}" }
  defaults()                  { dry defaults "$@" }
  sudo()                      { dry sudo "$@" }
  killall()                   { dry killall "$@" }
  osascript()                 { dry osascript "$@" }
  mkdir()                     { dry mkdir "$@" }
  chflags()                   { dry chflags "$@" }
  xattr()                     { dry xattr "$@" }
  dockutil()                  { dry dockutil "$@" }
  /usr/libexec/PlistBuddy()   { dry /usr/libexec/PlistBuddy "$@" }
  print "Dry run: nothing will be changed."
fi

# Warn if this is not the macOS version the script was reviewed against.
if [[ "$(sw_vers -productVersion)" != 27.* ]]; then
  print "Note: written for macOS 27; this Mac runs $(sw_vers -productVersion)."
fi

# Detect a built-in battery (MacBook). Only used to skip battery power settings.
IS_LAPTOP=0
[[ -n "$(ioreg -rc AppleSmartBattery 2>/dev/null)" ]] && IS_LAPTOP=1

# Confirm before changing anything. Skipped for a dry run, or when not run from
# a terminal. Esc or q cancels (so does Ctrl-C); any other key continues.
if (( ! DRY_RUN )) && [[ -t 0 ]]; then
  print "This will change system and app settings on $(scutil --get ComputerName 2>/dev/null || hostname)."
  read -rsk 1 "key?Press any key to start, or Esc / q to cancel. "
  print
  if [[ "$key" == $'\e' || "$key" == [qQ] ]]; then
    print "Cancelled. Nothing was changed."
    exit 1
  fi
fi

# Quit System Settings so it does not overwrite the changes below.
osascript -e 'tell application "System Settings" to quit'

# Ask for the administrator password once, then keep sudo alive until done.
if (( ! DRY_RUN )); then
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

###############################################################################
# General UI / Appearance                                                     #
###############################################################################

# Dark mode. Delete the key for Light. Default: unset (Light).
defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Switch Light/Dark automatically. Default: false.
defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool false

# Accent color: -1 graphite, 0 red, 1 orange, 2 yellow, 3 green, 4 blue, 5 purple, 6 pink.
# Default: unset (multicolor).
# defaults write NSGlobalDomain AppleAccentColor -int 4

# Always show scrollbars: WhenScrolling | Automatic | Always. Default: Automatic.
defaults write NSGlobalDomain AppleShowScrollBars -string "Always"

# Click in the scroll bar to jump to the spot clicked. Default: false.
defaults write NSGlobalDomain AppleScrollerPagingBehavior -bool true

# Sidebar icon size: 1 small, 2 medium, 3 large. Default: 2.
defaults write NSGlobalDomain NSTableViewDefaultSizeMode -int 1

# Prefer tabs when opening documents: manual | always | fullscreen. Default: fullscreen.
defaults write NSGlobalDomain AppleWindowTabbingMode -string "always"

# Double-click a window title bar: Maximize (zoom/fill) | Minimize | None. Default: Maximize.
defaults write NSGlobalDomain AppleActionOnDoubleClick -string "Maximize"

# Disable the animated focus ring. Default: true.
defaults write NSGlobalDomain NSUseAnimatedFocusRing -bool false

# Faster window resize animation for Cocoa apps. Default: unset (~0.2).
defaults write NSGlobalDomain NSWindowResizeTime -float 0.001

# Disable window open/close animations. Default: true.
defaults write NSGlobalDomain NSAutomaticWindowAnimationsEnabled -bool false

# Toolbar title rollover delay (proxy icon). Default: 0.5.
defaults write NSGlobalDomain NSToolbarTitleViewRolloverDelay -float 0

# Ctrl+Cmd+click anywhere in a window to drag it. [LOGOUT] Default: false.
defaults write NSGlobalDomain NSWindowShouldDragOnGesture -bool true

# Show ASCII control characters using caret notation in text views. Default: false.
defaults write NSGlobalDomain NSTextShowsControlCharacters -bool true

# Help Viewer windows not always on top. Default: false.
defaults write com.apple.helpviewer DevMode -bool true

# Floating Liquid Glass sidebar (macOS 26 look). macOS 27 is flatter. [VERIFY] Default: unset.
# defaults write NSGlobalDomain NSSplitViewItemSidebarDefaultsToFloatingAppearance -bool false

###############################################################################
# Windows & Documents                                                         #
###############################################################################

# Expand the save panel by default. Default: false.
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

# Expand the print panel by default. Default: false.
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# Save new documents to disk, not iCloud. Default: true.
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# Reopen windows when relaunching an app. The UI checkbox "Close windows when
# quitting an application" is on by default (= false). macos-defaults.com lists true.
defaults write NSGlobalDomain NSQuitAlwaysKeepsWindows -bool false

# Ask to keep changes when closing documents. Default: false.
defaults write NSGlobalDomain NSCloseAlwaysConfirmsChanges -bool true

# ??? I don't think I've had a problem with this so just skipping this default
# Don't let macOS terminate idle apps automatically. Default: false.
# defaults write NSGlobalDomain NSDisableAutomaticTermination -bool true

# ??? revisit if this annoys me due to app open expectations
# Don't restore System Settings windows on relaunch. Default: unset.
defaults write com.apple.systempreferences NSQuitAlwaysKeepsWindows -bool false

###############################################################################
# Text Input (substitutions that break code)                                  #
###############################################################################

# Disable automatic capitalization. Default: true.
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false

# Disable smart dashes. Default: true.
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false

# Disable "add period with double-space". Default: true.
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false

# Disable smart quotes. Default: true.
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false

# Disable auto-correct. Default: true.
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# Disable WebKit auto-correct (Safari, Mail, web views). Default: true.
defaults write NSGlobalDomain WebAutomaticSpellingCorrectionEnabled -bool false

# Disable automatic text completion. Default: true.
defaults write NSGlobalDomain NSAutomaticTextCompletionEnabled -bool false

# Disable inline predictive text. Default: true.
defaults write NSGlobalDomain NSAutomaticInlinePredictionEnabled -bool false

###############################################################################
# Keyboard                                                                    #
###############################################################################

# ??? Ideally I could turn this on and off but apparently it requires logout
# - in my testing it just requires app restart but that's not going to work
# for my ideal toggleable mode
# Hold a key to repeat it instead of showing the accent menu. [LOGOUT] Default: true.
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Key repeat rate. Lower = faster. 2 is the fastest UI value (1 goes past
# the slider and may be ignored on 27). [LOGOUT] Default: 6.
defaults write NSGlobalDomain KeyRepeat -int 2

# Delay until repeat. Lower = shorter. 15 is the shortest UI value. [LOGOUT] Default: 25.
defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Full keyboard navigation (Tab moves between all controls): 0 off, 2 on.
# Older scripts use 3; Sonoma and later document 0 and 2. Default: 0.
defaults write NSGlobalDomain AppleKeyboardUIMode -int 2

# ??? Probably want them as function keys and will reassign in karabiner?
# or reassign the consumer keys is easier?
# Use F1, F2, etc. as standard function keys. Default: false.
defaults write NSGlobalDomain com.apple.keyboard.fnState -bool false

# ??? which setting is useful for karabiner remapping?
# Fn/Globe key: 0 nothing, 1 change input source, 2 emoji, 3 dictation. [REBOOT]
# Default: 2 on Globe-key keyboards (macos-defaults.com lists 0).
# 
# ISSUE - can't read this and changing value in system settings doesn't affect
# might be global? not keyboard specific?
defaults write com.apple.HIToolbox AppleFnUsageType -int 0
# RESET:
# defaults delete com.apple.HIToolbox AppleFnUsageType

# Show the input-source indicator when switching languages. Default: true.
defaults write kCFPreferencesAnyApplication TSMLanguageIndicatorEnabled -bool true

# Keyboard backlight off after 1 minute of inactivity, in seconds. [LAPTOP] [VERIFY] Default: 10 s.
# defaults write com.apple.BezelServices kDimTime -int 60

###############################################################################
# Trackpad (built-in trackpad and Magic Trackpad)                             #
###############################################################################
# The built-in trackpad reads com.apple.AppleMultitouchTrackpad. A Bluetooth
# Magic Trackpad reads com.apple.driver.AppleBluetoothMultitouch.trackpad.
# Both are set. [LAPTOP] for the built-in one. [LOGOUT] for most of them.

# Tap to click. Default: false.
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Secondary click with two fingers. Default: true.
defaults write com.apple.AppleMultitouchTrackpad TrackpadRightClick -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadRightClick -bool true

# Corner secondary click: 0 off, 1 bottom-left, 2 bottom-right. Default: 0.
defaults write com.apple.AppleMultitouchTrackpad TrackpadCornerSecondaryClick -int 0
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadCornerSecondaryClick -int 0

# Click pressure: 0 light, 1 medium, 2 firm. Default: 1.
defaults write com.apple.AppleMultitouchTrackpad FirstClickThreshold -int 1
defaults write com.apple.AppleMultitouchTrackpad SecondClickThreshold -int 1

# Force Click and haptic feedback (false = enabled). Default: false.
defaults write com.apple.AppleMultitouchTrackpad ForceSuppressed -bool false

# Haptic click strength (0 is reported as "silent clicking"). [VERIFY] Default: 1.
# defaults write com.apple.AppleMultitouchTrackpad ActuationStrength -int 1

# Three-finger drag. Turns off Dragging/DragLock below. Default: false.
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true

# Double-tap-and-drag dragging, and drag lock. Default: false.
defaults write com.apple.AppleMultitouchTrackpad Dragging -bool false
defaults write com.apple.AppleMultitouchTrackpad DragLock -bool false

# Tracking speed, 0.0 to 3.0. [VERIFY] Default: 1.0.
# defaults write NSGlobalDomain com.apple.trackpad.scaling -float 1.5

# "Natural" scrolling (also applies to mice). Default: true.
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool true

# Pinch to zoom, and two-finger rotate. Default: true.
defaults write com.apple.AppleMultitouchTrackpad TrackpadPinch -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadRotate -bool true

# ??? I don't know that I use this much, but leaving it on
# Smart zoom (two-finger double-tap): 0 off, 1 on. Default: 1.
# defaults write com.apple.AppleMultitouchTrackpad TrackpadTwoFingerDoubleTapGesture -int 0

# Notification Center with a two-finger swipe from the right edge: 0 off, 3 on. Default: 3.
defaults write com.apple.AppleMultitouchTrackpad TrackpadTwoFingerFromRightEdgeSwipeGesture -int 3

# ??? OmniWM / Karabiner --- could use these gestures for workspaces & overview?
# Swipe between full-screen apps/Spaces with four fingers, not three: 0 off, 2 on.
# Three-finger drag above needs the three-finger swipe off. Default: 2 for both.
defaults write com.apple.AppleMultitouchTrackpad TrackpadFourFingerHorizSwipeGesture -int 2
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerHorizSwipeGesture -int 0

# Swipe up/down for Mission Control/App Exposé with four fingers, not three. Default: 2 for both.
defaults write com.apple.AppleMultitouchTrackpad TrackpadFourFingerVertSwipeGesture -int 2
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerVertSwipeGesture -int 0

# App Exposé gesture (swipe down). Default: false.
defaults write com.apple.dock showAppExposeGestureEnabled -bool true

# Show Desktop (spread thumb and three fingers). Default: true.
defaults write com.apple.dock showDesktopGestureEnabled -bool true

# Launchpad/Apps (pinch thumb and three fingers). Launchpad became "Apps" in 26. [VERIFY] Default: true.
defaults write com.apple.dock showLaunchpadGestureEnabled -bool true

# Look up and data detectors (three-finger tap): 0 off, 2 on. Default: 0 (Force Click is used).
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerTapGesture -int 0

# Swipe between pages with two fingers (browsers): Default: true.
defaults write NSGlobalDomain AppleEnableSwipeNavigateWithScrolls -bool true

