# Preview, QuickTime, Photos, Music, Calendar, Contacts                       #
###############################################################################

# Preview: don't reopen documents that were open when it quit. Default: true.
defaults write com.apple.Preview NSQuitAlwaysKeepsWindows -bool false

# QuickTime: auto-play videos when opened. Default: false.
defaults write com.apple.QuickTimePlayerX MGPlayMovieOnOpen -bool true

# Music: "Now Playing" notifications on song change. Default: true.
defaults write com.apple.Music userWantsPlaybackNotifications -bool false

# Calendar: show week numbers. [VERIFY] Default: false.
defaults write com.apple.iCal "Show Week Numbers" -bool true

