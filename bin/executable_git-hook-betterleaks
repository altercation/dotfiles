#!/bin/zsh
# git-hook-betterleaks: global pre-commit secret scan (hook.betterleaks in ~/.gitconfig).
# Rules: built-ins plus ~/.config/betterleaks/config.private (generated by
# chezmoi from 1Password DEV/dotfiles-private, field leak_patterns).
# A repo's own .betterleaks.toml is used instead, if it has one.
# Skip once: git commit --no-verify
# Off for one repo: git config hook.betterleaks.enabled false
export PATH="/opt/homebrew/bin:$PATH"   # GUI git apps may not have Homebrew on PATH

if ! command -v betterleaks &>/dev/null; then
  print -u2 "betterleaks not installed; skipping secret scan."
  exit 0                                # don't block commits on a new Mac
fi

CONFIG=()
if [[ -r .betterleaks.toml ]]; then     # hooks run at the repo's top level
  CONFIG=(-c .betterleaks.toml)
elif [[ -r $HOME/.config/betterleaks/config.private ]]; then
  CONFIG=(-c "$HOME/.config/betterleaks/config.private")
fi

exec betterleaks git --pre-commit --staged --redact --no-banner "${CONFIG[@]}" .
