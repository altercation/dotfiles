#! /usr/bin/env zsh

# DOTPRIVATE_*: ~/.config/shell/env.private (sourced by ~/.config/shell/init.sh;
# generated by chezmoi from 1Password DEV/dotfiles-private)
: ${DOTPRIVATE_TS_EXIT_NODE:?not set; see ~/.config/shell/env.private}
MULLVAD_NODE="$DOTPRIVATE_TS_EXIT_NODE"

osascript -e 'display notification "Changing exit node" with title "Tailscale Node"'

# cycle through exit states or just toggle exit on/off
if /usr/local/bin/tailscale status | grep -qE 'mullvad.*active'; then
	/usr/local/bin/tailscale set --exit-node=
	current_node="none"
else
	/usr/local/bin/tailscale set --exit-node=$MULLVAD_NODE
	current_node="${MULLVAD_NODE%%.*}"   # e.g. us-sea-wg-001
fi

osascript -e 'display notification "Exit node set to '${current_node}'" with title "Tailscale Node"'
