#!/usr/bin/env zsh
# DOTPRIVATE_*: ~/.config/shell/env.private (sourced by ~/.config/shell/init.sh;
# generated by chezmoi from 1Password DEV/dotfiles-private)

# control desk lamp switch

: ${DOTPRIVATE_IOT_DESKLIGHT_URL:?not set; see ~/.config/shell/env.private}
ON="click"
OFF="double-click"
#OLD ID="BF4DD830-C664-479A-87F9-6F27FAE3B0D2"
ID="AB6C5F22-89F3-4AD5-90AF-F96FD093F524"

# SAFETIME == from midnight to some morning hour avoid turning on the light to not wake kids
# CONNECTED == is computer connected to expected external display (at desk)

HOUR=$(( $(date +%-H) ))
[[ $HOUR -gt 6 && $HOUR -lt 22 ]] && SAFETIME=true || SAFETIME=false
/opt/homebrew/bin/displayplacer list | grep -q "$ID" && CONNECTED=true || CONNECTED=false

case "$1" in
  on) if $CONNECTED && $SAFETIME; then /usr/bin/curl "$DOTPRIVATE_IOT_DESKLIGHT_URL?event=$ON" &>/dev/null; fi ;;
  off) if $CONNECTED; then /usr/bin/curl "$DOTPRIVATE_IOT_DESKLIGHT_URL?event=$OFF" &>/dev/null; fi ;;
  docked) if $CONNECTED && $SAFETIME; then /usr/bin/curl "$DOTPRIVATE_IOT_DESKLIGHT_URL?event=$ON" &>/dev/null; fi ;;
esac
