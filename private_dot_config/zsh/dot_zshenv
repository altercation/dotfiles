
# .zshenv es@ethanschoonover.com

# https://zsh.sourceforge.io/Intro/intro_3.html

# ZSHDOTDIR -----------------------------------------------------------

export ZDOTDIR="$HOME/.config/zsh"

# SHARED SHELL STARTUP ------------------------------------------------
# ~/.config/shell/init.sh: shared by zsh, bash and sh (loads DOTPRIVATE_* values).
export ENV="$HOME/.config/shell/init.sh"   # interactive sh reads $ENV
# No BASH_ENV: scripts source env.private themselves; ENV covers interactive sh.
if [[ -r $ENV ]]; then source "$ENV"; fi

# PATH ----------------------------------------------------------------
export PATH=$PATH\
:$HOME/bin\
:$HOME/Documents/ark/bin\
:$HOME/arkon/mda/audio/scripts\
:$HOME/signal-proc/scripts\
:$HOME/.local/bin

# SSH CONFIG (1PASSWORD) ----------------------------------------------
# following requires a symlink to:
# ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
# and a configured .config/1Password/ssh/agent.toml file
# (see my new system deployment script)
export SSH_AUTH_SOCK=~/.1password/agent.sock

# SPECIAL PATHS -------------------------------------------------------
export BEETSDIR="$HOME/arkon/mda/audio/data/beets"
export PODCAST_ARCHIVER_CONFIG="$HOME/arkon/mda/audio/data/podcast-archiver/config.yaml"
export GOKU_EDN_CONFIG_FILE="$HOME/.config/karabiner/karabiner.edn"

