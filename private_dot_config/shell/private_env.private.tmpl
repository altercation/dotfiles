{{- $item := onepassword "dotfiles-private" "DEV" -}}
# ~/.config/shell/env.private: generated by chezmoi from 1Password DEV/dotfiles-private.
# Don't edit here: edit the 1Password item, then run `chezmoi apply`.
# Sourced by ~/.config/shell/init.sh, and directly by some ~/bin scripts.
# POSIX only: every line must be `export NAME='value'`. zsh, bash and sh
# (bash 3.2 in sh mode) all source this file, so no shell-specific syntax.
{{ range $item.fields -}}
{{   if and .label .value (ne .label "notesPlain") (ne .label "leak_patterns") -}}
export DOTPRIVATE_{{ .label | upper }}='{{ .value | replace "'" "'\\''" }}'
{{   end -}}
{{ end -}}
