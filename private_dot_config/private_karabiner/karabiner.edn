 :templates {             ;; New window via the app's own AppleScript command (%1$s = app name,
             ;; %2$s = command). If the app isn't running, it just launches,
             ;; because launching already opens a window.
             ;; TODO - does :open or :oid do the same?
             :new-window "osascript -e 'if application \"%1$s\" is running then tell application \"%1$s\" to %2$s' -e 'tell application \"%1$s\" to activate'"
             ;; nudge is a fast rescue command when a window spawns with the omniwm workspace bar obscuring it
             :nudge "osascript -e 'tell application \"System Events\" to tell (first application process whose frontmost is true) to tell window 1 to set position to {(item 1 of (get position)) + %1$s, (item 2 of (get position)) + %2$s}'"
             ;;:omniwm-kill "/usr/bin/pkill -x OmniWM; while /usr/bin/pgrep -qx OmniWM; do sleep 0.2; done; /usr/bin/open -b com.barut.OmniW"
             :tailscale-exit-cycle "$HOME/bin/tsexit"
             :test1 "say -v Zosia 'hello my frend, do you hav ze dokuments?'"
             :test2 "say -v Zosia 'hello'; say -v Zosia 'goodbye'"
             :omniwm-cli "/opt/homebrew/bin/omniwmctl command %1$s"
             ;; multi variant below doesn't use ; since multiple shell commands in goku/karabiner sometimes fail in that case. chaining with no-fail conditionals instead. hacky.
             :omniwm-cli-multi "/opt/homebrew/bin/omniwmctl command %1$s || : && /opt/homebrew/bin/omniwmctl command %2$s"
             :omniwm-kill "$HOME/bin/omniwm-kill"
             :omniwm-scratchpad "$HOME/bin/omniwm-scratchpad %1$s %2$s"   ; in :templates
             :omniwm-float-center "$HOME/bin/omniwm-float-center"
             :omniwm-swap-workspaces "$HOME/bin/omniwm-swap-workspaces"
             :omniwm-split "$HOME/bin/omniwm-split %1$s" 
             :omniwm-workspace-preset "$HOME/bin/omniwm-workspace-preset %1$s"
             ;; keymap help overlay (see HELP-MODE); the [p] keeps pkill from matching its own shell
             :keymap-help "$HOME/bin/keymap-help"
             :keymap-help-hide "/usr/bin/pkill -f 'JavaScript .*keymap-hel[p]'"
             ;;
};templates

 :main [;; primary rule blocks (each shows as named entry in the Karabiner GUI)

        ;; {:des "TEST: y = say test phrase" :rules [[:!CTOSy [:test2]]]}

        ;; OPMODE <- CAPSLOCK (Operations Mode)
        ;; (combined with WMMODE)
        ;;
        ;; Note on modes:
        ;; These rule blocks are structured so that I can separate out
        ;; the OPMODE-WM-* blocks into an entirely separate mode.
        ;; For example OPMODE-WM-* could become WMMODE-*
        ;; At the time of this note I've experimented with both consolidated
        ;; OPMODE-* and split OPMODE / WMMODE, each triggered by differen
        ;; modifiers (held capslock / held tab, respectively).
        ;; Given that: 1) I'm trying to reduce cognitive load and 2) the
        ;; primary need to separate out was me wanting to experiment with
        ;; "bare" hjkl as cursor nav in OPMODE and window nav in WMMODE, I have
        ;; decided that the benefits outweigh the costs. I'm also just trying to
        ;; avoid collisions of keys between OPMODE and any nominal WMMODE, so
        ;; I am consolidating into OPMODE-* for this. Effectively, however, I could
        ;; revert to a split mode in future and I could also turn off any of the
        ;; OPMODE-WM-* rule blocks or easily switch to a different WM if needed
        ;; as long as I maintain consistency in separating out rule blocks cleanly.
        ;;
        ;; This block toggles TWO layer variables: opsmode and wmmode. If I want to
        ;; separate out the wmmode to a different trigger key, all I need to do is remove
        ;; the assignement of that value here and move it to another rule block
        ;; like the tab block commented out below.
        ;;
        ;; SUMMARY
        ;; Core shortcuts and activations. My primary control layer.
        ;; Separate from WM mode so that I can turn off WM specific items on a system
        ;; that doesn't have that WM installed (or can more easily refactor for a diff WM)
        ;;
        ;; DETAILS
        ;; ## lets any other modifiers be held first (shift+caps still enters the layer)
        ;; tap=esc / release=leave layer
        ;;
        {:des "OPSMODE-KEY (capslock): Activation key for OPSMODE. Hold caps lock = operations layer (tap = esc)"
         :rules [[:##caps_lock [["opsmode" 1] ["wmmode" 1]] nil {:alone :escape :afterup [["opsmode" 0] ["wmmode" 0]]}]]}

        ;; WN-MODE <- TAB
        ;;
        ;; NB: OFF UNLESS NEEDED TO SEPARATE OUT MODES!
        ;;
        ;; SUMMARY
        ;; One of two "primary" modes (the other being OPSMODE)
        ;; Separating modes so that I can disable or change to a different window manager
        ;; and turn off WM specific rules.
        ;;
        ;; DETAILS
        ;; #SS lets shift through, so shift+tab still taps as shift-tab.
        ;; tap=tab / release=leave layer, clear notification if present from ":held"
        ;; 
        ;; REFERENCE
        ;; for ref (removed :held component of rule)
        ;; :held [:noti :wm "Window Movement Mode"] :params {:held 200} ; to avoid flashing on just tab
        ;; {:des "OMNIWM-MODE-ACTIVATE (tab): Activation key for OMNIWM-MODE. Hold Tab = window management w/OmniWM"
        ;;  :rules [[:#SStab [["wmmode" 1]] nil {:alone :tab :afterup [["wmmode" 0] [:noti :wm]]}]]}

        ;; CURSOR-MODE (tab)
        ;; hjkl as cursor only movement
        ;; {:des "OMNIWM-MODE-ACTIVATE (tab): Activation key for OMNIWM-MODE. Hold Tab = window management w/OmniWM"
        ;; :rules [[:#SStab [["wmmode" 1]] nil {:alone :tab :afterup [["wmmode" 0] [:noti :wm]]}]]}

        ;; QUIT-MODE
        ;;
        ;; SUMMARY
        ;; "latched layer": entered by caps+q (see CONTROL-MODE), stays on
        ;; with nothing held, ends on the next key press or after 5s. The second q works
        ;; with or without the control-mode key (capslock) still held.
        ;; The cancelling key is ingested and discarded.
        ;; `:repeat false` so holding the second q can't quit the next app as well.
        ;;
        ;; IMPORTANT POSITION NOTE
        ;; This block must stay above CONTROL-MODE-* (may be below CONTROL-MODE-ACTIVATE)
        ;; because Karabiner will trigger on first mode match and both control-mode and
        ;; quit-mode will be active simultaneously. I could trigger this on any cmd-q
        ;; but I'd rather limit its use to control-mode.
        ;;
        ;; DETAILS
        ;; a second 'q' in this mode quits focused application
        ;; `o` in this mode restarts omniwm
        ;; while in mode, any other key (caps lock, escape, shift+q, ...) = cancel
        ;;
        {:des "OPMODE-QUIT: control mode `q`: q again = quit app"
         :rules [:quit-mode ;; all rules in this block are for QUIT-MODE

                 [:q [{:key :q :modi :left_command :repeat false} ["quit-mode" 0] [:noti :quit]]]
                 [:o [[:omniwm-kill] ["quit-mode" 0] [:noti :quit]]]
                 [{:any :key_code :modi {:optional :any}} [["quit-mode" 0] [:noti :quit]]]

                 ;;
                 ]}

        ;; HELP-MODE
        ;;
        ;; SUMMARY
        ;; "latched layer": entered by caps+/ (see OPSMODE-CORE), which also shows the
        ;; keymap help overlay (~/bin/keymap-help). Stays on with nothing held; the next
        ;; key press of any kind hides the overlay and ends the mode.
        ;; The dismissing key is ingested and discarded (so / again = toggle off,
        ;; and caps+esc dismisses instead of locking the screen).
        ;;
        ;; IMPORTANT POSITION NOTE
        ;; Must stay above the OPSMODE-* blocks, same reason as QUIT-MODE.
        ;;
        {:des "OPSMODE-HELP: caps lock + / shows keymap help; any key hides it"
         :rules [:help-mode ;; all rules in this block are for HELP-MODE

                 [{:any :key_code :modi {:optional :any}} [[:keymap-help-hide] ["help-mode" 0]]]

                 ;;
                 ]}

        ;; {:des "OPSMODE-CURSOR: Vimalike. HJKL in opsmode move the cursor."
        ;;  :rules [:opsmode ;; all rules in this block are for opsmode
        ;;          ;; vim direction keys as arrows
        ;;          [:h :left_arrow]
        ;;          [:j :down_arrow]
        ;;          [:k :up_arrow]
        ;;          [:l :right_arrow]
        ;;          ;;
        ;;          ]}

        {:des "OPSMODE-CORE: Basic muscle memory shortcuts mapped to operations mode."
         :rules [:opsmode ;; all rules in this block are for opsmode

                 ;; new windows and tab / tab control
                 [:#SSw :!Cw]           ; command-w (close window)
                 [:#SSn :!COn :finder]   ; command-n (new window finder since I have 'new windows open in tabs' set in finder to eat random finder windows that pop up)
                 [:#SSn :!Cn]           ; command-n (new window)
                 [:t :!Cn :vscode]      ; t -> command-n (new vscode doc tab)
                 [:t :!Ct]              ; command-t (new tab)
                 [:!SSt :!SCt]          ; command-shift-t (undo close tab in most browsers)
                 ;; TODO: add a condition for the above rule that limits to browsers
                 [:open_bracket :!SCopen_bracket]   ; move to the prev (left) tab in a tabbed view
                 [:close_bracket :!SCclose_bracket] ; move to the next (right) tab in a tabbed view

                 ;; copy paste undo
                 [:z :!Cz] ; undo
                 [:x :!Cx] ; cut
                 [:c :!Cc] ; copy
                 [:v :!Cv] ; paste

                 ;; mouse
                 [{:pkey :button1} {:pkey :button1 :modi :left_command}] ; left click -> cmd-click

                 ;; quit-mode (confirm before quit since q is danger close to capslock/tab primary keys)
                 ;; q -> quit mode (notification shows): q again quits, * key cancels, 5s timeout
                 [:q [["quit-mode" 1] [:noti :quit "q again to quit\no to kill omniwm"]] nil
                  {:delayed {:invoked [["quit-mode" 0] [:noti :quit]]    ; 5s bail
                             :canceled [["quit-mode" 0] [:noti :quit]]}  ; non q cancel
                   :params {:delay 5000}}]                               ; this rule only

                 ;; system control
                 [:escape :!CTq] ; fast lock system
                 [:s :!CTOf13]   ; soundsource window

                 ;; activate launcher of choice 
                 [:spacebar :!CTOspacebar]

                 ;; / = show keymap help until the next key press (see HELP-MODE)
                 [:slash [[:keymap-help] ["help-mode" 1]]]

                 ;;
                 ]}

        {:des "OPSMODE-APPS: Spawn/raise/control primary applications."
         :rules [:opsmode ;; all rules in this block are for opsmode

                 ;; non-open mode fast new windows
                 ;; see OPSMODE-WM-APPS below for plain return quake term
                 [:!SSreturn_or_enter [:new-window "Ghostty" "new window"]]
                 [:!SSbackslash [:new-window "Safari" "make new document"]]
                 [:!SSdelete_or_backspace [:new-window "Finder" "make new Finder window"]]

                 ;; networking
                 [:e [:tailscale-exit-cycle]] ; cycle tailscale exit node

                 ;; open-mode
                 ;; enter OPEN-MODE (see above); it times out after 10s if no key is pressed.
                 ;; any key press cancels timer. see the open-mode rules block
                 ;;  [:o [["open-mode" 1] [:noti :open "Open: s f r g c"]] nil
                 ;;   {:delayed {:invoked [["open-mode" 0] [:noti :open]]    ; 10s, nothing pressed = leave open-mode
                 ;;              :canceled [["open-mode" 0] [:noti :open]]}   ; timer stopped early (e.g. a click) = leave too
                 ;;    :params {:delay 10000}}]                            ; this rule only

                 ;;
                 ]}

        {:des "OPSMODE-CURSOR-OVERRIDE: HJKL as cursors in specific apps."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)
                 ;; vim direction keys = NAVIGATE within workspaces
                 [:h :left_arrow  :tuna]
                 [:j :down_arrow  :tuna]
                 [:k :up_arrow    :tuna]
                 [:l :right_arrow :tuna]
                 ;;
                 ]}

        ;; Layer conditions use the keyword form: :wm-mode means "variable wm-mode is 1",
        ;; the same as ["wm-mode" 1]. As the first item in :rules it applies to every rule after it.
        ;; Goku doesn't check the name, so a typo (:wm-mdoe) compiles silently and never matches.
        {:des "OPSMODE-WM-NAV: HJKL navigation and window movement."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)

                 ;; vim direction keys = NAVIGATE within workspaces
                 [:h :left_arrow  :omniwm]
                 [:j :down_arrow  :omniwm]
                 [:k :up_arrow    :omniwm]
                 [:l :right_arrow :omniwm]

                 ;; vim direction keys = NAVIGATE within workspaces
                 [:h [:omniwm-cli "focus left"]]
                 [:j [:omniwm-cli "focus down"]]
                 [:k [:omniwm-cli "focus up"]]
                 [:l [:omniwm-cli "focus right"]]

                 ;; vim direction keys + Shift = MOVE window
                 ;; note that this DOES cross monitor boundaries
                 [:!SSh [:omniwm-cli "move left"]]
                 [:!SSj [:omniwm-cli "move down"]]
                 [:!SSk [:omniwm-cli "move up"]]
                 [:!SSl [:omniwm-cli "move right"]]

                 ;; vim direction keys + Command = MOVE *column*
                 ;; note that this does NOT cross monitor boundaries
                 [:!CC#SSh [:omniwm-cli "move-column left"]]
                 [:!CC#SSj [:omniwm-cli "move-column down"]]
                 [:!CC#SSk [:omniwm-cli "move-column up"]]
                 [:!CC#SSl [:omniwm-cli "move-column right"]]

                 ;; vim direction keys + Option = NUDGE current window (if floating)
                 [:!OO#SSh [:nudge -40   0]] ; left
                 [:!OO#SSj [:nudge   0  40]] ; down
                 [:!OO#SSk [:nudge   0 -40]] ; up
                 [:!OO#SSl [:nudge  40   0]] ; right

                 ;;
                 ]}

        {:des "OPSMODE-WM-WORKSPACES: Workspace 1-9 navigation and window movement."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)
                 ;; 0-9 = JUMP to workspaces
                 [:1 [:omniwm-cli "switch-workspace 1"]]
                 [:2 [:omniwm-cli "switch-workspace 2"]]
                 [:3 [:omniwm-cli "switch-workspace 3"]]
                 [:4 [:omniwm-cli "switch-workspace 4"]]
                 [:5 [:omniwm-cli "switch-workspace 5"]]
                 [:6 [:omniwm-cli "switch-workspace 6"]]
                 [:7 [:omniwm-cli "switch-workspace 7"]]
                 [:8 [:omniwm-cli "switch-workspace 8"]]
                 [:9 [:omniwm-cli "switch-workspace 9"]]
                 ;; 0-9+Shift = MOVE window to workspace
                 [:!SS1 [:omniwm-cli "move-to-workspace 1"]]
                 [:!SS2 [:omniwm-cli "move-to-workspace 2"]]
                 [:!SS3 [:omniwm-cli "move-to-workspace 3"]]
                 [:!SS4 [:omniwm-cli "move-to-workspace 4"]]
                 [:!SS5 [:omniwm-cli "move-to-workspace 5"]]
                 [:!SS6 [:omniwm-cli "move-to-workspace 6"]]
                 [:!SS7 [:omniwm-cli "move-to-workspace 7"]]
                 [:!SS8 [:omniwm-cli "move-to-workspace 8"]]
                 [:!SS9 [:omniwm-cli "move-to-workspace 9"]]
                 ;; 0-9+Command = MOVE COLUMN to workspace
                 [:!CC1 [:omniwm-cli "move-column-to-workspace 1"]]
                 [:!CC2 [:omniwm-cli "move-column-to-workspace 2"]]
                 [:!CC3 [:omniwm-cli "move-column-to-workspace 3"]]
                 [:!CC4 [:omniwm-cli "move-column-to-workspace 4"]]
                 [:!CC5 [:omniwm-cli "move-column-to-workspace 5"]]
                 [:!CC6 [:omniwm-cli "move-column-to-workspace 6"]]
                 [:!CC7 [:omniwm-cli "move-column-to-workspace 7"]]
                 [:!CC8 [:omniwm-cli "move-column-to-workspace 8"]]
                 [:!CC9 [:omniwm-cli "move-column-to-workspace 9"]]
                 ;; omniwm workspace related
                 [:p             [:omniwm-cli "switch-workspace back-and-forth"]] ;toggle between last two ws
                 [:y             [:omniwm-cli "toggle-overview"]]                 ; ws overview
                 [:i             [:omniwm-cli "switch-workspace prev"]]           ; jump left a workspace
                 [:o             [:omniwm-cli "switch-workspace next"]]           ; jump right a workspace
                 [:!SSi          [:omniwm-cli "move-to-workspace up"]]            ; move left a workspace
                 [:!SSo          [:omniwm-cli "move-to-workspace down"]]          ; move right a workspace
                 [:u             [:omniwm-swap-workspaces]]                       ; custom swap up/down ws
                 ;;
                 ]}
        
        {:des "OPSMODE-WM-WINDOWS: Window management within OmniWM."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)
                 ;; other omniwm window management commands 
                 [:f [:omniwm-cli "toggle-container-full-primary-span"]] ; full primary span
                 [:!SSf [:omniwm-cli "toggle-native-fullscreen"]]        ; native fullscreen
                 [:semicolon [:omniwm-split]]
                 [:!SSsemicolon [:omniwm-cli "cycle-size backward"]]             ; grow (loops)
                 [:quote [:omniwm-cli "center-column"]]              ; center column on display
                 ;;[:quote [:omniwm-cli "cycle-size forward"]]             ; grow (loops)
                 [:!SSquote [:omniwm-cli "balance-sizes"]]           ; 50/50
                 ;;[:!SSquote [:omniwm-cli "cycle-size backward"]]         ; shrink (loops)
                 ;;[:!SSg [:omniwm-split 66.667]]
                 [:g [:omniwm-cli "toggle-focused-window-floating"]
                  nil {:delayed {:invoked :!TFc :canceled :!TFc}
                       :params {:delay 150}}]                            ; toggle float
                 [:!SSg [:omniwm-cli-multi "rescue-offscreen-windows"
                         "raise-all-floating-windows"]]                   ; leeloo dallas multipass
                 [:!CCt [:omniwm-cli "toggle-column-tabbed"]]            ; toggle tabbed state of col
                 ;;
                 ]}

        {:des "OPSMODE-WM-WSPRESETS: Jump and launch apps for workspace."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)
                 [:!SSCC7 [:omniwm-workspace-preset "7 com.flexibits.fantastical2.mac:66.667 com.apple.reminders:33.333"]]
                 [:!SSCC8 [:omniwm-workspace-preset "8 com.apple.Mail com.apple.MobileSMS com.hnc.Discord"]]
                 ;;
                 ] 
         }

        {:des "OPSMODE-WM-MENUS: Access system icons and menus in OmniWM."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)
                 [:m [:omniwm-cli "open-menu-anywhere"]]                 ; key press menu anywhere
                 [:!SSm [:omniwm-cli "hidden-bar panel"]]                ; key press hidden icons
                 [:!CCm [:omniwm-cli "hidden-bar"]]                ; key press hidden icons
                 ;;
]};

        {:des "OPSMODE-WM-MOUSE-BUTTONS: Top level mouse button remapping for omniwm"
         :rules [;; top-level, no layer (but wm specific hence :des)
                 [{:pkey :button4} [:omniwm-cli "open-menu-anywhere"]]
                 ;;
                 ]}

        {:des "OPSMODE-WM-APPS: Launch and control key applications."
         :rules [:wmmode ;; all rules in this block are for wmmode (currently consolidated with opsmode)

                 ;; wm specific launcher
                 [:!CCspacebar [:omniwm-cli "open-command-palette"]]

                 ;; app toggles on keyboard right
                 [:return_or_enter [:omniwm-cli "toggle-quake-terminal"]]
                 [:backslash [:omniwm-scratchpad 5 "com.apple.safari"]]
                 ;;[:delete_or_backspace [:omniwm-scratchpad 2 "com.binarynights.ForkLift"]]
                 [:delete_or_backspace [:omniwm-scratchpad 2 "com.apple.Finder"]]
                 ;; keep the follow rule above the 2SHIFT=CAPSLOCK block so it fires first
                 [:right_shift :right_shift :remind-me-faster {:alone :escape}]                 ; app frontmost: tap = esc (dismiss)
                 [:right_shift :right_shift nil {:alone [:oid "chojubo.addReminder"]}]          ; otherwise: tap = open it
                 ;;[:right_shift :escape nil {:alone [:oid "chojubo.addReminder"]} :remind-me-faster]

                 ;; scratchpad function keys
                 [:f1 [:omniwm-cli "toggle-quake-terminal"]]
                 ;;[:f2 [:omniwm-scratchpad 2 "com.binarynights.ForkLift"]]
                 [:f2 [:omniwm-scratchpad 2 "com.apple.Finder"]]
                 [:f3 [:omniwm-scratchpad 3 "com.iconfactory.Tot"]]
                 [:f4 [:omniwm-scratchpad 4 "com.apple.MobileSMS"]]

                 ;;
                 ]}

        {:des "2SHIFT=CAPSLOCK: both shifts together = caps lock toggle"
         :rules [;; top-level, no layer
                 [{:sim [:left_shift :right_shift] :modi {:optional :any}} :caps_lock nil {:params {:sim 100}}]
                 ;;
                 ]}
        ;; optional :any is required or it turns caps lock on but never off
        ;; the "nil" in this rule is a place holder for the conditions slot of this rule
        ;; which is unused, and we was the options map section for the :params in to 
        ;; lengthen this particular sim timing just a tad.

        ;; {:des "SLOW-LOCK: hold esc for 1s = lock screen (cmd+ctrl+q)"
        ;; :rules [[:escape {:key :escape :repeat false} nil {:held :!CTq :params {:held 1000}}]]}

        {:des "FAST-LOCK: esc+ctrl = lock screen (cmd+ctrl+q)"
         :rules [;; top-level, no layer
                 [:!Tescape :!CTq]
                 ;;
                 ]}

        {:des "OPSMODE-UNIVERSAL-PALETTE: shift-p = Universal application command palette"
         :rules [:opsmode ;; all rules in this block are for opsmode
                 [:!SSspacebar [:!SCp] :vscode]
                 [:!SSspacebar [:!Ck] :discord]
                 ;;
                 ]}

        {:des "OPSMODE-UNIVERSAL-SIDEBARS: b = left sidebar toggle (+shift = right sidebar)"
         :rules [:opsmode ;; all rules in this block are for opsmode
                 [:sidebar-toggle [:!SCl] :safari]           ; bookmarks bar
                 [:sidebar-toggle [:!Sl] :google-chrome]     ; vertical tab sidebar
                 [:sidebar-toggle [:!CTs] :finder]            ; sidebar
                 [:sidebar-toggle-alt [:!CSp] :finder]        ; preview
                 [:sidebar-toggle [:!COs] :forklift]         ; left nav sidebar
                 [:sidebar-toggle-alt [:!CSp] :forklift]     ; info pane
                 [:sidebar-toggle [:!Cb] :vscode]            ; show/hide explorer pane
                 [:sidebar-toggle-alt [:!COb] :vscode]       ; show/hide secondary sidebar
                 [:sidebar-toggle [:!COb] :obsidian]         ; toggle left sidebar (assign in app settings)
                 [:sidebar-toggle-alt [:!CTb] :obsidian]     ; toggle right sidebar (assign in app settings)
                 [:sidebar-toggle [:!Cb] :claude]            ; show/hide sidebar
                 [:sidebar-toggle-alt [:!Cperiod] :claude]   ; show/hide sidebar
                 [:sidebar-toggle [:!Cu] :discord]           ; toggle channel user list
                 [:sidebar-toggle-alt [:!Cu] :discord]       ; toggle channel user list (duplicate functionality)
                 [:sidebar-toggle [:!COs] :fantastical]      ; toggle calendar sidebar
                 [:sidebar-toggle [:!CTs] :reminders]        ; toggle reminders list sidebar
                 ;; not working... why? [:sidebar-toggle     [:!Oi]   :numbers-creator-studio] ; toggle inspector
                 ;;[:sidebar-toggle     [:!Cb]]                      ; old default: no-app-match = default cmd-b

                 ;; DEFAULTS: If app is not defined above, notify rather than typing b/B
                 ;;[:sidebar-toggle-alt [:noti :sidebar "no alt sidebar mapped"] nil {:afterup [:noti :sidebar]}]

                 [:sidebar-toggle [:noti :sidebar "no left sidebar toggle mapped"] nil
                  {:delayed {:invoked [:noti :sidebar]    ; nothing else pressed in time, clear after the delay
                             :canceled [:noti :sidebar]}   ; another key pressed first so clear right away
                   :params {:delay 1500}}]                ; this rule only; Default profile is still :delay 300

                 [:sidebar-toggle-alt [:noti :sidebar "no right sidebar toggle mapped"] nil
                  {:delayed {:invoked [:noti :sidebar]    ; nothing else pressed in time, clear after the delay
                             :canceled [:noti :sidebar]}   ; another key pressed first so clear right away
                   :params {:delay 1500}}]                ; this rule only; Default profile is still :delay 300

                 ;;
                 ]}

        ;; may or may not use; currently not mapping control mode `o` activation
        ;; most key apps are launched with a direct control mode key press
        ;; other apps can be launched with my current launcher of choice
        ;;
        ;; Latched mode: entered by caps+o (see WM-MODE), stays on with nothing held,
        ;; and ends on the very next key press (or after 10s). The cancelling key is swallowed.
        ;; Apps with an AppleScript new-window command use the :new-window template
        ;; (new window if running, otherwise launch). The rest (ForkLift, VS Code: no
        ;; new-window command) just open with {:softf {:open {:bundle_identifier …}}},
        ;; the long form of :oid, because [:oid …] only works as a rule's whole output:
        ;; inside a list of actions it compiles to null. Templates work fine nested.
        ;; This block must stay above CAPSLOCK->WM-MODE, so a caps lock tap cancels
        ;; open-mode instead of entering wm-mode (Karabiner uses the first match).
        ;; {:des "OPEN-MODE: caps lock + o, then (after letting go) one key = new window (or open app); any other key cancels"
        ;;  :rules [:open-mode   ; applies to every rule below
        ;;          [:s [[:new-window "Safari" "make new document"] ["open-mode" 0] [:noti :open]]]  ; safari
        ;;          [:f [[:new-window "Finder" "make new Finder window"] ["open-mode" 0] [:noti :open]]]  ; finder
        ;;          [:r [{:softf {:open {:bundle_identifier "com.binarynights.ForkLift"}}} ["open-mode" 0] [:noti :open]]]  ; forklift
        ;;          [:g [[:new-window "Ghostty" "new window"] ["open-mode" 0] [:noti :open]]]  ; ghostty
        ;;          [:c [[:new-window "Google Chrome" "make new window"] ["open-mode" 0] [:noti :open]]]  ; chrome
        ;;          [:v [{:softf {:open {:bundle_identifier "com.microsoft.VSCode"}}} ["open-mode" 0] [:noti :open]]]  ; vscode

        ;;          ;; any other key (o, caps lock, escape, modified keys...) = cancel
        ;;          [{:any :key_code :modi {:optional :any}} [["open-mode" 0] [:noti :open]]]]}
        ] ;; END :main
