;; variable that points at this karabiner.edn in the ~/.config/karabiner folder:
;; export GOKU_EDN_CONFIG_FILE="$HOME/.config/karabiner/karabiner.edn"

;; INVOCATION AND COMPILATION --------------------------------------------------
;; `goku` compile EDN to karabiner.json (located in ~/.config/karabiner/)
;; `gokuw` continually compile, watching EDN config file for changes
;; `brew services start goku` runs `gokuw` in background as service, saves logs
;; to ~/Library/Logs/goku.log

;; DOCUMENTATION & OFFICIAL SOURCES --------------------------------------------
;; n.b. - NOT ALL CODES AND ACTIONS ARE PROPERLY DOCUMENTED IN THE GOKU DOCS!
;;        SEE MY NOTES THROUGHOUT FOR NON DOCUMENTED VALUES.
;; Karabiner:        https://karabiner-elements.pqrs.org
;; GokuRakuJoudo:    https://github.com/yqrashawn/GokuRakuJoudo
;; EDN format:       https://github.com/edn-format/edn
;; Goku Tutorial:    https://github.com/yqrashawn/GokuRakuJoudo/blob/master/tutorial.md
;; Key Codes:        https://github.com/yqrashawn/GokuRakuJoudo/blob/master/src/karabiner_configurator/keys_info.clj
;; Goku Rules        https://github.com/yqrashawn/GokuRakuJoudo/blob/master/src/karabiner_configurator/rules.clj
;; From Modifiers:    https://karabiner-elements.pqrs.org/docs/json/complex-modifications-manipulator-definition/from/modifiers/
;; Examples:         https://github.com/yqrashawn/GokuRakuJoudo/blob/master/examples.org
;; Sample Configs:    https://github.com/yqrashawn/GokuRakuJoudo/tree/master/resources/configurations/edn

;; BASIC CONCEPTS --------------------------------------------------------------
;; cf https://gist.github.com/johnlindquist/f6ecdcf1dcc8ec4fac5ad90eb768acaf
;; (above url missing some of the newer shortcodes for modifiers)
;;
;; Rules live inside `:main` and follow this pattern:
;;     [:from :to :conditions {:options}]
;; Only `:from` and `:to` are required:
;;   {:main [{:des "My rules"
;;            :rules [[:caps_lock :escape]     ; Caps Lock → Escape
;;                   [:a [:1 :2 :3]]           ; a → type "123"
;;                   [:b "open -a Safari"]]}]} ; b → run shell command

;; MODIFIER CODES --------------------------------------------------------------
;; Short and long form modifier reference for use in definitions in this file.
;; Note: some of these
;;
;; "Mandatory" means that the event triggers only if the modifiers marked as
;; mandatory are pressed. The modifiers are removed from to events.
;;
;; "Optional" means that the event triggers *regardless* of whether the marked
;; modifiers are pressed. The modifiers in the optional case are passed through
;; the to event.
;;
;; "Mandatory/Optional" prefixes:
;; !    = mandatory
;; #    = optional
;; ##   = optional any
;; 
;; "Chiral" modifier codes:
;; !!   = mandatory :left_command :left_control :left_option :left_shift
;;        (technically this is ! mandatory followed by ! hyper)
;; C    = :left_command
;; T    = :left_control
;; O    = :left_option
;; S    = :left_shift
;; Q    = :right_command
;; W    = :right_control
;; E    = :right_option
;; R    = :right_shift
;;
;; "Ambidextrous" modifier codes:
;; These are not yet in the goku docs other than in the changelog.
;; c.f. https://github.com/yqrashawn/GokuRakuJoudo/blob/master/CHANGELOG.org?plain=1#L186-L203
;; CC   = :command
;; TT   = :control
;; OO   = :option
;; SS   = :shift
;; !!A  = mandatory :command :control :option :shift
;;        Note that technically this is a mandatory prefix plus a !A which is a
;;        hyper key as goku defines it (cmd+ctrl+opt+shift). However #!A is not
;;        implemented (does not compile) so you will only use or see !!A.

;; EXAMPLES --------------------------------------------------------------------
;; In these examples I use the terms "lean" and "rich" to refer to the two
;; common implementations of the "hyper key" on macos. These are either:
;; * RICH: Command + Control + Option + Shift
;; * LEAN: Command + Control + Option (no Shift)
;; 
;; :!CTOx      = mandatory left command+control+option held and "x" pressed
;; :!CCTTOOx   = mandatory ANY command+control+option held and "x" pressed
;; :!Cx        = mandatory left command pressed, x pressed
;; :#Cx        = x pressed, optional left command+x also matches,
;;               (left command passed to result)
;; :#CCx       = x pressed, optional ANY command+x also matches
;;               (whichever command pressed is passed to result)
;; :!C#Sx      = mandatory left command+x with optional left shift also matching
;;               (left shift passed to result)
;; :!C#SSx     = mandatory left command+x with optional ANY shift also matching
;;               (whichever shift is pressed - if any - is passed to result)
;; :!CCx       = mandatory ANY command+x
;; :!CC##x     = mandatory ANY command+x,
;;               optional any other modifiers are passed through
;; :!CQx       = mandatory BOTH commands (left & right) plux 'x'
;; :!CQ##x     = mandatory BOTH commands (left & right) plux 'x',
;;               any other optional modifiers allowed and pass through
;; :!!Ax       = ambidextrous, mandatory "rich" hyper-key + x
;;               (ctrl-opt-cmd-shift + x)
;; :!CCTTOOSSx = same as above (ambidextrous mandatory rich hyper key + x)
;; :#CCTTOOSSx = ambidextrous optional rich hyper key + x
;;               (rich hyperkey modifiers get passed through)
;; :!CCTTOOx   = ambidextrous mandatory "lean" hyper-key + x (ctrl-opt-cmd + x)
;; :#CCTTOOx   = ambidextrous optional "lean" hyper-key + x (ctrl-opt-cmd + x)
;;               (lean hyperkey modifiers get passed through)
;; :!CTOx      = left side lean hyper-key + x
;;
;; You can also use key names:
;; :##caps_lock
;; :!left_command
;;
;; Note that modifiers *must* be specified as either mandatory or optional.
;; The initial ! or # may not be omitted (in both the input and output).

;; ACTIONS ---------------------------------------------------------------------
;; [:1 [:op "/Applications/Emacs.app"]]             ; open app by file path
;; [:2 [:oid "org.gnu.Emacs"]]                      ; open app by bundle ID
;; [:3 [:oi 1]]                                     ; switch to an app by its position in the recent-apps list
;; [:4 [:softf {:dbc {:button 0}}]]                 ; double-click
;; [:5 [:softf {:sleep {:delay_milliseconds 500}}]] ; sleep the system
;; [:6 [:softf {:setmpos {:x 0 :y 0 :screen 0}}]]   ; move the mouse cursor

