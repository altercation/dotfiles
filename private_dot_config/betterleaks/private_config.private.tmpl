{{- $patterns := "" -}}
{{- range (onepassword "dotfiles-private" "DEV").fields -}}
{{-   if eq .label "leak_patterns" }}{{ $patterns = .value }}{{ end -}}
{{- end -}}
# ~/.config/betterleaks/config.private: generated by chezmoi from 1Password
# DEV/dotfiles-private (field leak_patterns, one regex per line).
# Don't edit here: edit the 1Password item, then run `chezmoi apply`.
# Used by ~/bin/git-hook-betterleaks (global git pre-commit hook).

[extend]
useDefault = true   # keep the built-in rules; add the ones below

{{ range $i, $p := splitList "\n" $patterns -}}
{{   if trim $p -}}
[[rules]]
id = "dotprivate-{{ add $i 1 }}"
description = "Private value (1Password DEV/dotfiles-private leak_patterns, line {{ add $i 1 }})"
regex = '''{{ trim $p }}'''

{{   end -}}
{{ end -}}
