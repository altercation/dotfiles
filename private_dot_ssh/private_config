# ~/.ssh/config (public; chezmoi). Host details live in the included files.
# ssh uses the first value it finds for each setting, so Includes go first
# and Host * goes last. config.d comes before 1Password's file: its Host blocks
# set HostName, which 1Password's `Match Host <address>` blocks match on.
Include ~/.ssh/config.d/*              # hosts.private (chezmoi from 1Password) + local.private (this Mac only)
Include ~/.ssh/1Password/config        # 1Password bookmarks: which key per host (generated by 1Password)

Host *
    IdentityAgent "~/.1password/agent.sock"
